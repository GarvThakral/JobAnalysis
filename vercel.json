{
    "version": 2,
    "builds": [
      {
        "src": "./index.ts",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/"
      }
    ],
    "build": {
    "commands": [
      "npm install",
      "npm run build",
      "prisma generate"
    ]
  }
  }